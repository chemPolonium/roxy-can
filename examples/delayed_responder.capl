// 延迟应答节点：收到请求后等 200ms 再应答（命名一次性定时器）。
//
// 请求：0x6A0，byte 0 = 服务号
// 应答：0x6A1，byte 0 = 服务号 + 0x40，byte 1 = 0x01（正应答）
//
// set_timer 武装的定时器触发一次即失效；再次武装会重新计时，
// 所以请求风暴不会堆积应答——每条新请求只把应答往后推 200ms。
// 需要立即取消时调 cancel_timer("resp")。

let service = 0;

on message 0x6A0 {
    service = frame_byte(0);
    print("request 0x" + service, "at", now());
    set_timer("resp", 200);
}

on timer "resp" {
    print("answering 0x" + service);
    send(0x6A1, service + 0x40, 0x01);
}

// 任意帧 0x100 到来视为总线繁忙，撤回未决的应答。
on message 0x100 {
    cancel_timer("resp");
}

// 派生信号节点：emit_value 把脚本算出的值发布成"派生信号"，
// 在信号选择树的"派生信号"分组里出现，可像数据库信号一样
// 进 Graphics 画曲线、进 Data 看数值。
//
// 行为：
//   - 每 10ms 发布 SpeedKmh：把 EngineSpeed（rpm）换算成 km/h
//     ——换算系数 = 轮周长(m) × 60 / 1000，这里取 0.075
//   - 每 10ms 发布 LoadPct：油门与转速的归一化组合，演示多信号合成
//   - 数值滑出量程时发一条日志，演示派生信号的消费侧判读
//
// 注意：sig() 在该信号一次都没出现时会报运行时错误并熔断节点，
// 所以先让总线上跑起 0x100（例如用发生器发车或回放一段日志），
// 再启用本节点。

let kmh = 0.0;

on timer 10 {
    // 单位换算：rpm -> km/h（示例系数，按实车标定替换）。
    kmh = sig(0x100, "EngineSpeed") * 0.075;
    emit_value("SpeedKmh", kmh);

    // 组合派生：量纲归一后的"负载百分比"。
    emit_value("LoadPct", clamp(kmh / 1.8, 0, 100));
}

on timer 1000 {
    print("t =", now(), "s  speed =", kmh, "km/h");
}
